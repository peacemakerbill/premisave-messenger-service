# Premisave messenger-service: STAGING values.
# Copy to deploy/env/staging.env (which git ignores) and fill in. For every other setting see .env.example.
# Use this file with Docker Compose (--env-file), Fly.io (fly secrets import), Heroku (heroku config:set) or as a
# list to type into Render and Coolify. Write values without quotes and without trailing spaces.
#
# Staging must NEVER share a database, secrets or API keys with production.

SPRING_PROFILES_ACTIVE=staging

# Compose staging starts its own MongoDB and Redis and sets these two itself. On Render, Fly.io, Heroku and
# Railway use your own: MongoDB Atlas for MONGODB_URI, and a Redis address WITH its password for REDIS_URL
# (redis:// or rediss://).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/premisave-messenger-staging?retryWrites=true&w=majority
# REDIS_URL=rediss://default:password@host:6379

# Sign in goes through the auth-service of the SAME environment.
AUTH_SERVICE_URL=https://auth.staging.example.com
# JWT_SECRET must equal the auth-service JWT_SECRET, and INTERNAL_API_KEY its API_KEY. Generate once with
# openssl rand -base64 32   and   openssl rand -hex 32
JWT_SECRET=replace-with-the-auth-service-jwt-secret
INTERNAL_API_KEY=replace-with-the-auth-service-api-key

# Password for the /actuator metrics endpoints (the health endpoint stays public)
ACTUATOR_USER=actuator
ACTUATOR_PASSWORD=replace-with-a-long-random-password

# This service's own public address. Download links inside messages start with it.
STORAGE_PUBLIC_BASE_URL=https://messenger.staging.example.com
# What group invite and call links start with (the web page that opens them)
GROUP_INVITE_BASE_URL=https://staging.example.com/join
CALLS_LINK_BASE_URL=https://staging.example.com/call

# Calls. Leave the key and secret empty to keep calls off. LiveKit Cloud or your own LiveKit server.
LIVEKIT_URL=wss://livekit.staging.example.com
LIVEKIT_API_URL=https://livekit.staging.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Call recordings (server with Docker only, see docs/CALLS.md). LOCAL or NETWORK (a NAS mounted on the server).
# CALLS_RECORDING_ENABLED=false
# CALLS_RECORDINGS_MODE=NETWORK
# CALLS_RECORDINGS_HOST_DIR=/mnt/premisave-nas/premisave-recordings
# CALLS_RECORDINGS_MIN_FREE_MB=500
