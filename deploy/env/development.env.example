# Premisave messenger-service: DEVELOPMENT values.
# For Docker Compose development nothing is required (docker-compose.yml has defaults). Copy this to .env
# (next to docker-compose.yml) to change them. For every other setting see .env.example.
# Write values without quotes and without trailing spaces.

SPRING_PROFILES_ACTIVE=dev

# The auth-service on this computer (for example the one started by its own docker-compose.yml).
AUTH_SERVICE_URL=http://host.docker.internal:8080

# Same values as the auth-service development defaults.
JWT_SECRET=eW91ci12ZXJ5LXNlY3VyZS1qd3Qtc2VjcmV0LWtleS0zMi1ieXRlcyE=
INTERNAL_API_KEY=dev-internal-api-key

STORAGE_PUBLIC_BASE_URL=http://localhost:8081

# Calls. Leave the key and secret empty to keep calls off. See docs/CALLS.md and deploy/livekit.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Folders the admin dashboard may choose for storage (full paths separated by commas). Blank allows only the storage folder
# itself. The .env values are the starting point, and what an admin saves from the dashboard wins until "Reset to .env".
# The folder picker in the app shows only these folders, so list more to choose other ones, for example:
#   STORAGE_ALLOWED_ROOTS=/home/you/file-storage,/mnt
STORAGE_ALLOWED_ROOTS=
