# ============================================================
# Premisave Messenger Service - Environment Variables Template
# Copy this file to .env and fill in real values.
# .env is gitignored - this .env.example is safe to commit.
# ============================================================

# -- MongoDB --
MONGODB_URI=mongodb://localhost:27017/premisave-messenger

# -- Redis --
REDIS_URL=redis://localhost:6379

# -- Actuator Basic Auth --
ACTUATOR_USER=actuator
ACTUATOR_PASSWORD=change-me

# -- JWT (must match auth-service's jwt.secret exactly) --
# Generate with: openssl rand -base64 32
JWT_SECRET=

# -- Auth Service (Feign client target) --
AUTH_SERVICE_URL=http://localhost:8080

# -- File attachments (images, video, audio, documents, any file type) --
# LOCAL stores files under STORAGE_ROOT. NETWORK uses a share already mounted at STORAGE_NETWORK_MOUNT_PATH.
STORAGE_MODE=LOCAL
STORAGE_ROOT=./data/messenger-storage
# Public address of this service. Download links inside messages start with this.
STORAGE_PUBLIC_BASE_URL=http://localhost:8081
# Largest single file. STORAGE_MAX_REQUEST_SIZE must stay a little above it.
STORAGE_MAX_FILE_SIZE=50MB
STORAGE_MAX_REQUEST_SIZE=60MB
# How long a link inside a message works, and how long an unsent upload is kept.
STORAGE_URL_TTL=6h
STORAGE_UNCLAIMED_TTL=24h
# Optional. Leave blank to sign links with JWT_SECRET.
STORAGE_SIGNING_SECRET=
# Used only when STORAGE_MODE=NETWORK. Keep the lines, leave blank if unused.
STORAGE_NETWORK_PROTOCOL=SMB
STORAGE_NETWORK_HOST=
STORAGE_NETWORK_SHARE=
STORAGE_NETWORK_MOUNT_PATH=
STORAGE_NETWORK_DIRECTORY=premisave-messenger
STORAGE_NETWORK_REQUIRE_MOUNT=true