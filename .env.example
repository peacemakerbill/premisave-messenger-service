# ============================================================
# Premisave Messenger Service: environment variables template
# Copy this file to .env and fill in real values.
# .env is gitignored. This .env.example is safe to commit.
# ============================================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/premisave-messenger

# Redis
REDIS_URL=redis://localhost:6379

# Actuator basic auth
ACTUATOR_USER=actuator
ACTUATOR_PASSWORD=change-me

# JWT (must match the auth-service jwt.secret exactly)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Auth service (Feign client target)
AUTH_SERVICE_URL=http://localhost:8080
# The shared service key. Use the same value as API_KEY in auth-service. The messenger uses it to ask
# auth-service to send notification emails (made an admin or the owner, added to or removed from a group).
# Leave it empty and the notifications still appear in the app, but no email is sent.
INTERNAL_API_KEY=
# Set to false to turn the notification emails off even when the key is set.
NOTIFICATION_EMAILS_ENABLED=true

# Messages
# Hours after sending that a person can edit their own message. 0 turns editing off.
MESSAGE_EDIT_WINDOW_HOURS=1

# Statuses (posts followers can watch until they disappear)
# The longest a status can stay, in hours. Nobody can pick more than this.
STATUS_MAX_HOURS=24
# How long a status stays when the person does not pick, in hours. Never above STATUS_MAX_HOURS.
STATUS_DEFAULT_HOURS=24
# Most characters in a text status or a caption, and in a comment.
STATUS_TEXT_MAX_LENGTH=700
STATUS_COMMENT_MAX_LENGTH=300
# true lets followers open a person's past statuses too. The owner always can.
STATUS_PAST_VISIBLE_TO_FOLLOWERS=false

# File attachments (images, video, audio, documents, any file type)
# LOCAL stores files under STORAGE_ROOT. NETWORK uses a share already mounted at STORAGE_NETWORK_MOUNT_PATH.
STORAGE_MODE=LOCAL
STORAGE_ROOT=./data/messenger-storage
# Public address of this service. Download links inside messages start with this.
STORAGE_PUBLIC_BASE_URL=http://localhost:8081
# Largest single file. STORAGE_MAX_REQUEST_SIZE must stay a little above it.
STORAGE_MAX_FILE_SIZE=50MB
STORAGE_MAX_REQUEST_SIZE=60MB
# How long a link inside a message works, and how long an unsent upload is kept.
STORAGE_URL_TTL=6h
STORAGE_UNCLAIMED_TTL=24h
# Optional. Leave blank to sign links with JWT_SECRET.
STORAGE_SIGNING_SECRET=

# Network share (used only when STORAGE_MODE=NETWORK; keep the lines, leave blank if unused)
STORAGE_NETWORK_PROTOCOL=SMB
STORAGE_NETWORK_HOST=
STORAGE_NETWORK_SHARE=
STORAGE_NETWORK_MOUNT_PATH=
STORAGE_NETWORK_DIRECTORY=premisave-messenger
STORAGE_NETWORK_REQUIRE_MOUNT=true

# Group invite links. The shared link is GROUP_INVITE_BASE_URL, a slash and a random code.
GROUP_INVITE_BASE_URL=https://premisave.com/join
# The longest an admin can make a link last, in hours (a link can also have no expiry).
GROUP_INVITE_MAX_EXPIRY_HOURS=8760
# The most joins an admin can limit a link to.
GROUP_INVITE_MAX_USES_LIMIT=100000


# Audio and video calls (LiveKit). Leave LIVEKIT_API_KEY and LIVEKIT_API_SECRET empty to keep calls switched off.
# Set up the LiveKit server first: see docs/CALLS.md and deploy/livekit/.
# What the apps connect to for audio and video. Use wss:// with a real domain in production.
LIVEKIT_URL=ws://localhost:7880
# What this service uses to reach LiveKit (to mute or remove people). Usually the same host, over http.
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=
# At least 32 characters. Generate with: openssl rand -hex 32
LIVEKIT_API_SECRET=
# Seconds a phone rings before the call counts as missed.
CALLS_RING_TIMEOUT_SECONDS=45
# The most people in one call, and the most a group call rings at once.
CALLS_MAX_PARTICIPANTS=50
CALLS_RING_LIMIT=32
# Minutes a join token works. It is only needed to connect.
CALLS_TOKEN_TTL_MINUTES=120
# What a call link starts with (the link is this, a slash and a code) and how long it lasts.
CALLS_LINK_BASE_URL=https://premisave.com/call
CALLS_LINK_TTL_HOURS=168
CALLS_CHAT_MAX_LENGTH=2000
